      {
        "click": "role=checkbox[name='Select feature/export-v2']"
      },
      {
        "wait": 200
      }
    ],
    "fullPage": true
  },
  {
    "name": "repo-hygiene",
    "steps": [
      {
        "click": "role=tab[name=/Branch & Repo Hygiene/]"
      },
      {
        "click": "role=button[name=/Scan Repositories/]"
      },
      {
        "waitFor": "text=/Stale Branches \\(\\d+\\)/"
      },
      {
        "click": "role=tab[name=/Repository Hygiene/]"
      },
      {
        "waitFor": "text=promo-video.mp4"
